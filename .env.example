# Copia este archivo, renómbralo a ".env" y pega los datos de tu app web de Firebase.
# Están en Firebase > Configuración del proyecto (engranaje) > General > Tus apps > SDK setup and configuration.
# Estos datos son públicos por diseño (viajan en la página). Lo que protege tus notas son las reglas de firestore.rules.

VITE_FIREBASE_API_KEY=pega-aqui-apiKey
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_APP_ID=pega-aqui-appId
