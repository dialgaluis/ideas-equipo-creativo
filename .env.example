# Copia este archivo, renómbralo a ".env" y pega tus claves de Supabase.
# Están en Supabase > Project Settings > API.
#
# SOLO la clave pública "anon" (o "publishable"). NUNCA pongas aquí la clave "service_role" (o "secret").

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=pega-aqui-la-clave-anon-publica
